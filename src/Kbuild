UWG_NAME ?= umbrawg

ccflags-y := -D'pr_fmt(fmt)=KBUILD_MODNAME ": " fmt'
ccflags-y += -D'UWG_NAME="$(UWG_NAME)"'
ccflags-y += -Wframe-larger-than=2048
ccflags-$(CONFIG_UMBRAWG_DEBUG) += -DDEBUG -g
ccflags-$(if $(WIREGUARD_VERSION),y,) += -D'WIREGUARD_VERSION="$(WIREGUARD_VERSION)"'
ccflags-$(if $(OMIT_ENDPOINTS),y,) += -D'OMIT_ENDPOINTS="$(OMIT_ENDPOINTS)"'

uwg-y := main.o noise.o device.o peer.o timers.o queueing.o send.o receive.o socket.o peerlookup.o allowedips.o ratelimiter.o cookie.o netlink.o junk.o header_protection.o cc.o cc_bbr.o cc_fb.o tunnel.o

obj-$(if $(KBUILD_EXTMOD),m,$(CONFIG_UMBRAWG)) := $(UWG_NAME).o
$(UWG_NAME)-y := $(uwg-y)
