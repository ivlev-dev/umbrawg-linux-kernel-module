AWG_NAME ?= umbra-wg

ccflags-y := -D'pr_fmt(fmt)=KBUILD_MODNAME ": " fmt'
ccflags-y += -D'AWG_NAME="$(AWG_NAME)"'
ccflags-y += -Wframe-larger-than=2048
ccflags-$(CONFIG_UMBRA_WG_DEBUG) += -DDEBUG -g
ccflags-$(if $(WIREGUARD_VERSION),y,) += -D'WIREGUARD_VERSION="$(WIREGUARD_VERSION)"'
ccflags-$(if $(OMIT_ENDPOINTS),y,) += -D'OMIT_ENDPOINTS="$(OMIT_ENDPOINTS)"'

awg-y := main.o noise.o device.o peer.o timers.o queueing.o send.o receive.o socket.o peerlookup.o allowedips.o ratelimiter.o cookie.o netlink.o junk.o header_protection.o

obj-$(if $(KBUILD_EXTMOD),m,$(CONFIG_UMBRA_WG)) := $(AWG_NAME).o
$(AWG_NAME)-y := $(awg-y)
